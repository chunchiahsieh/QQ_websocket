# Local viewer / web service
MONITOR_SESSION_SECRET=replace-with-a-random-32-character-or-longer-secret
ACCOUNT_ADMIN_URL=http://127.0.0.1:5092
ACCOUNT_ADMIN_INTERNAL_KEY=replace-with-the-same-32-character-or-longer-secret-as-AccountAdmin

# AccountAdmin only. These create the first administrator once on an empty
# persistent store. Do not place MT, DG, or user credentials in this file.
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password
ADMIN_DATA_DIR=C:\secure-data\TableAccountAdmin

# DG collector only
DG_RELAY_URL=http://127.0.0.1:5091
DG_RELAY_API_KEY=replace-with-a-random-32-character-or-longer-secret
