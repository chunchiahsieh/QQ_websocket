<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>J神・圖形來世｜管理中心</title><link rel="icon" href="/jshen-logo.svg"/>
<style>
*{box-sizing:border-box}body{margin:0;background:#101827;color:#e4eaf4;font:16px system-ui,sans-serif}main{max-width:1200px;margin:auto;padding:32px 24px}h1{font-size:26px;margin:0}header{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}.panel{background:#192536;border:1px solid #324359;border-radius:12px;padding:24px;margin:20px 0}h2{font-size:19px;margin:0 0 20px}label{display:block;font-size:14px;margin:12px 0 6px}input,button{font:inherit;border-radius:6px;padding:10px;border:1px solid #556479}input{background:#0e1828;color:#fff;max-width:100%}button{background:#22b4cb;color:#061924;font-weight:600;cursor:pointer}button.secondary{background:transparent;color:#ddd}.row{display:flex;gap:14px;flex-wrap:wrap;align-items:end}.field{display:flex;flex-direction:column}small,.muted{color:#a8b7cb}.notice{padding:14px;border-radius:6px;background:#164b3c}.error{background:#642c35}.scroll{overflow-x:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:14px 8px;border-bottom:1px solid #344157;white-space:nowrap}td input[type=password]{width:160px}.login{max-width:440px;margin:10vh auto}.login input{width:100%}.login button{margin-top:24px;width:100%}details{margin-top:14px}.badge{border-radius:5px;padding:4px 8px;background:#33445a;font-size:12px}a{color:#76d9ef}
</style></head><body><main>@RenderBody()</main></body></html>
