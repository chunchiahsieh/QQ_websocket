<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>J神・圖形來世｜管理中心</title><link rel="icon" href="/jshen-logo.svg"/>
<style>
.expiry-picker{min-width:270px}.expiry-inputs{display:flex;gap:8px;align-items:center}.expiry-inputs input{min-width:0}.expiry-inputs input[type=date]{flex:1}.expiry-inputs input[type=time]{width:112px}.expiry-presets{display:flex;gap:6px;flex-wrap:wrap;margin-top:7px}.chip{padding:5px 8px;border-radius:999px;background:#132a3b;color:#c8f4ff;border-color:#2c7890;font-size:12px}.chip:hover{background:#1b5269}.expiry-preview{display:block;margin-top:5px;color:#8ed4df;font-size:12px}.expiry-picker.compact{min-width:360px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
*{box-sizing:border-box}body{margin:0;background:#101827;color:#e4eaf4;font:16px system-ui,sans-serif}main{max-width:1200px;margin:auto;padding:32px 24px}h1{font-size:26px;margin:0}header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.panel{background:#192536;border:1px solid #324359;border-radius:12px;padding:24px;margin:20px 0}h2{font-size:19px;margin:0 0 20px}label{display:block;font-size:14px;margin:12px 0 6px}input,button{font:inherit;border-radius:6px;padding:10px;border:1px solid #556479}input{background:#0e1828;color:#fff;max-width:100%}button{background:#22b4cb;color:#061924;font-weight:600;cursor:pointer}button.secondary{background:transparent;color:#ddd}.row{display:flex;gap:14px;flex-wrap:wrap;align-items:end}.field{display:flex;flex-direction:column}small,.muted{color:#a8b7cb}.notice{padding:14px;border-radius:6px;background:#164b3c}.error{background:#642c35}.scroll{overflow-x:auto}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:14px 8px;border-bottom:1px solid #344157;white-space:nowrap}td input[type=password]{width:160px}.login{max-width:440px;margin:10vh auto}.login input{width:100%}.login button{margin-top:24px;width:100%}details{margin-top:14px}.badge{border-radius:5px;padding:4px 8px;background:#33445a;font-size:12px}a{color:#76d9ef}.admin-menu{display:flex;flex-wrap:wrap;gap:10px;padding:10px 12px;background:#0e1828;border:1px solid #324359;border-radius:10px;margin-bottom:20px}.admin-menu a{display:inline-flex;align-items:center;padding:9px 13px;border-radius:7px;border:1px solid #36536d;text-decoration:none;color:#d8f5ff;background:#132a3b}.admin-menu a:hover{background:#1b4056}.admin-menu .front-link{margin-left:auto;border-color:#9a7a3f;color:#ffe8a9}.section-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}.settings-table input:not([type=checkbox]){width:150px}.settings-table td:first-child{min-width:100px}.form-actions{display:flex;justify-content:flex-end;margin-top:16px}.danger{background:#7b2938;color:#fff;border-color:#b54c5d}.danger:hover{background:#963446}
</style></head><body><main>@RenderBody()</main></body></html>
