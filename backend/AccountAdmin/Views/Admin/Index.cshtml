@model List<AccountView>
<header><div><h1>J神・圖形來世 · 管理中心</h1><p class="muted">使用者帳號管理 · @Model.Count 個帳號 · 台灣時間 UTC+8</p><a href="/">← 返回前台</a></div><form asp-action="Logout" method="post"><button class="secondary">登出管理</button></form></header>
@if(TempData["Success"] is string success){<p class="notice" role="status">@success</p>}
@if(TempData["Error"] is string error){<p class="notice error" role="alert">@error</p>}
<section class="panel"><h2>新增使用者</h2><form asp-action="Create" method="post" class="row">
<div class="field"><label for="new-user">帳號</label><input id="new-user" name="username" required minlength="3" maxlength="64" pattern="[a-zA-Z0-9_.\-]+" autocomplete="off"/></div>
<div class="field"><label for="new-pass">初始密碼（至少 6 字元）</label><input id="new-pass" name="password" type="password" required minlength="6" maxlength="128" autocomplete="new-password"/></div>
<div class="field"><label for="new-expiry">到期時間</label><input id="new-expiry" name="expires" type="datetime-local" required/></div><button>新增帳號</button></form></section>
<section class="panel"><h2>使用者列表</h2><p class="muted">修改後舊驗證憑據立即失效；停用取代刪除，保留帳號紀錄。</p><div class="scroll"><table><thead><tr><th>帳號／狀態</th><th>到期時間／啟用／重設密碼</th></tr></thead><tbody>
@foreach(var account in Model){
<tr><td>@account.Username <span class="badge">@(!account.Enabled ? "已停用" : account.ExpiresAt<=DateTimeOffset.UtcNow ? "已到期" : "有效")</span></td><td><form asp-action="Update" method="post" class="row">
<input type="hidden" name="id" value="@account.Id"/>
<input aria-label="@account.Username 到期時間" name="expires" type="datetime-local" value="@account.ExpiresAt.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy-MM-ddTHH:mm")" required/>
<label><input type="checkbox" name="enabled" value="true" checked="@account.Enabled"/> 啟用</label>
<input aria-label="@account.Username 新密碼" name="password" type="password" placeholder="留空不更改密碼" minlength="6" maxlength="128" autocomplete="new-password"/><button>儲存</button></form></td></tr>
}
</tbody></table></div></section>
<section class="panel"><details><summary>變更管理員密碼</summary><form asp-action="Password" method="post" class="row"><div class="field"><label for="current">目前密碼</label><input id="current" name="current" type="password" required maxlength="128" autocomplete="current-password"/></div><div class="field"><label for="next">管理員新密碼（至少 4 字元）</label><input id="next" name="next" type="password" required minlength="4" maxlength="128" autocomplete="new-password"/></div><button>變更並登出</button></form></details></section>
